# 이 파일을 tools/social.env 로 복사하고 값을 채우세요 (이름 그대로 "social.env").
#   Windows 탐색기에서 복사 → 이름 바꾸기, 또는:  cp tools/social.env.example tools/social.env
# 비워 둔 채널은 자동으로 건너뜁니다. 하나만 채워도 그 채널로 게시됩니다.
# 이 파일은 .gitignore 에 있어서 저장소·사이트에 올라가지 않습니다.

# ── 텔레그램 (가장 쉬움, 5분) ─────────────────────────────
# 발급: 텔레그램에서 @BotFather → /newbot → 토큰
TELEGRAM_BOT_TOKEN=
# 홍보할 채널/그룹의 숫자 ID (채널이면 -100 으로 시작)
TELEGRAM_CHAT_ID=

# ── 디스코드 (3분) ───────────────────────────────────────
# 발급: 서버 설정 → 연동 → 웹훅 → 새 웹훅 → URL 복사
DISCORD_WEBHOOK_URL=

# ── 블루스카이 (5분) ─────────────────────────────────────
# 발급: bsky.app 설정 → 앱 비밀번호 → 새로 만들기
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# ── X / 트위터 ───────────────────────────────────────────
# 2026-09 확인: X API 는 무료 등급이 없고 '사용량 과금(크레딧)' 방식이다.
# 그래서 이 칸은 비워 두고 X 는 --next 로 문구를 꺼내 수동 게시하는 편을 권한다.
# (쓰기로 결정했다면) 발급: developer.x.com → 앱 → Keys and tokens (앱 권한을 Read and Write 로 먼저)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── 페이스북 페이지 (15분) ───────────────────────────────
# 발급: developers.facebook.com → 앱 → Graph API Explorer → pages_manage_posts 권한
FB_PAGE_ID=
FB_PAGE_TOKEN=
